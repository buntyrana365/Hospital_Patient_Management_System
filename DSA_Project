#include <iostream>
#include <vector>
#include <string>
#include <iomanip>
using namespace std;

// Patient structure
struct Patient {
    int id;
    string name;
    int age;
    string disease;
    string doctor;
    int roomNo;
};

void printHeader() {
    cout << "\n====================================================\n";
    cout << "              HOSPITAL PATIENT MANAGEMENT\n";
    cout << "====================================================\n";
}

void printPatient(const Patient &p) {
    cout << left
         << setw(8) << p.id
         << setw(20) << p.name
         << setw(6) << p.age
         << setw(20) << p.disease
         << setw(20) << p.doctor
         << setw(8) << p.roomNo << "\n";
}

void addPatient(vector<Patient> &patients) {
    Patient p;
    cout << "\nEnter patient ID: ";
    cin >> p.id;

    for (const auto &patient : patients) {
        if (patient.id == p.id) {
            cout << "Patient ID already exists!\n";
            return;
        }
    }

    cin.ignore();
    cout << "Enter patient name: ";
    getline(cin, p.name);

    cout << "Enter age: ";
    cin >> p.age;
    cin.ignore();

    cout << "Enter disease: ";
    getline(cin, p.disease);

    cout << "Enter doctor name: ";
    getline(cin, p.doctor);

    cout << "Enter room number: ";
    cin >> p.roomNo;

    patients.push_back(p);
    cout << "Patient added successfully!\n";
}

void viewAllPatients(const vector<Patient> &patients) {
    if (patients.empty()) {
        cout << "\nNo patients available.\n";
        return;
    }

    cout << "\nPatient Records:\n";
    cout << left
         << setw(8) << "ID"
         << setw(20) << "Name"
         << setw(6) << "Age"
         << setw(20) << "Disease"
         << setw(20) << "Doctor"
         << setw(8) << "Room\n";
    cout << string(82, '-') << "\n";

    for (const auto &p : patients) {
        printPatient(p);
    }
}

int findPatientIndex(const vector<Patient> &patients, int id) {
    for (int i = 0; i < patients.size(); i++) {
        if (patients[i].id == id)
            return i;
    }
    return -1;
}

void searchPatient(const vector<Patient> &patients) {
    int id;
    cout << "\nEnter patient ID to search: ";
    cin >> id;

    int index = findPatientIndex(patients, id);
    if (index == -1) {
        cout << "Patient not found.\n";
        return;
    }

    cout << "\nPatient found:\n";
    cout << left
         << setw(8) << "ID"
         << setw(20) << "Name"
         << setw(6) << "Age"
         << setw(20) << "Disease"
         << setw(20) << "Doctor"
         << setw(8) << "Room\n";
    cout << string(82, '-') << "\n";
    printPatient(patients[index]);
}

void updatePatient(vector<Patient> &patients) {
    int id;
    cout << "\nEnter patient ID to update: ";
    cin >> id;

    int index = findPatientIndex(patients, id);
    if (index == -1) {
        cout << "Patient not found.\n";
        return;
    }

    cout << "\nUpdate patient details:\n";
    cin.ignore();

    cout << "Enter new name: ";
    getline(cin, patients[index].name);

    cout << "Enter new age: ";
    cin >> patients[index].age;
    cin.ignore();

    cout << "Enter new disease: ";
    getline(cin, patients[index].disease);

    cout << "Enter new doctor name: ";
    getline(cin, patients[index].doctor);

    cout << "Enter new room number: ";
    cin >> patients[index].roomNo;

    cout << "Patient record updated successfully!\n";
}

void deletePatient(vector<Patient> &patients) {
    int id;
    cout << "\nEnter patient ID to delete: ";
    cin >> id;

    int index = findPatientIndex(patients, id);
    if (index == -1) {
        cout << "Patient not found.\n";
        return;
    }

    patients.erase(patients.begin() + index);
    cout << "Patient deleted successfully!\n";
}

int main() {
    vector<Patient> patients;
    int choice;

    do {
        printHeader();
        cout << "1. Add Patient\n";
        cout << "2. View All Patients\n";
        cout << "3. Search Patient\n";
        cout << "4. Update Patient\n";
        cout << "5. Delete Patient\n";
        cout << "6. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                addPatient(patients);
                break;
            case 2:
                viewAllPatients(patients);
                break;
            case 3:
                searchPatient(patients);
                break;
            case 4:
                updatePatient(patients);
                break;
            case 5:
                deletePatient(patients);
                break;
            case 6:
                cout << "\nExiting Hospital Management System...\n";
                break;
            default:
                cout << "\nInvalid choice! Please try again.\n";
        }

        cout << "\nPress Enter to continue...";
        cin.ignore();
        cin.get();
        system("cls"); // Clear screen (works in Windows)

    } while (choice != 6);

    return 0;
}